cmake_minimum_required(VERSION 3.28)
include("${AETHERMIND_SOURCE_DIR}/cmake/AetherMindTests.cmake")

function(expect_label name label expected)
    aethermind_test_labels("${name}" labels)
    if(expected AND NOT label IN_LIST labels)
        message(FATAL_ERROR "${name} is missing label ${label}: ${labels}")
    elseif(NOT expected AND label IN_LIST labels)
        message(FATAL_ERROR "${name} unexpectedly has label ${label}: ${labels}")
    endif()
endfunction()

