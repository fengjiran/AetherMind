# Doxyfile for AetherMind — Phase 1 public API documentation.
#
# Per docs/guides/cpp_comment_guidelines.md §1.6:
#   EXTRACT_ALL = NO            (only explicitly documented entities)
#   JAVADOC_AUTOBRIEF = NO      (explicit @brief required)
#   QT_AUTOBRIEF = NO           (explicit @brief required)
#
# To generate docs and capture the warning baseline:
#   cmake -S . -B build -DBUILD_DOCS=ON
#   cmake --build build --target aethermind_docs
# The warning count is written to build/docs/doxygen_warnings.log;
# compare against docs/api/doxygen_baseline.txt after each comment batch.

PROJECT_NAME           = "AetherMind"
PROJECT_BRIEF          = "Phase-1 CPU inference runtime for Llama-family models"
OUTPUT_DIRECTORY       = build/docs
INPUT                  = include/aethermind
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp
EXCLUDE                =
EXCLUDE_PATTERNS       = */3rdparty/* */build/* */tests/*

# --- Extraction policy (§1.6) -------------------------------------------
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO

# Require explicit tags; undocumented public API surfaces as warnings.
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = build/docs/doxygen_warnings.log
WARN_FORMAT            = "$file:$line: $text"

# --- Output -------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO

# --- Source browsing (useful during audit, can be disabled later) --------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES

# --- Preprocessing ------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO

# --- Diagrams (optional; graphviz required) ------------------------------
HAVE_DOT               = YES
CLASS_DIAGRAMS         = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

# --- Misc ----------------------------------------------------------------
QUIET                  = NO
FULL_PATH_NAMES        = YES
SHORT_NAMES            = NO
TAB_SIZE               = 4
OPTIMIZE_OUTPUT_FOR_C  = NO
TYPEDEF_HIDES_STRUCT   = NO
